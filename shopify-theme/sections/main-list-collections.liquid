<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <h1>Collections</h1>
    </div>
    <div class="collection-list">
      {%- for col in collections -%}
        <a class="collection-card" href="{{ col.url }}">
          {%- if col.image -%}
            <img src="{{ col.image | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy">
          {%- elsif col.products.first.featured_media -%}
            <img src="{{ col.products.first.featured_media | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy">
          {%- endif -%}
          <div class="collection-card__overlay">
            <h3 class="collection-card__title">{{ col.title }}</h3>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "List collections", "settings": [] }
{% endschema %}