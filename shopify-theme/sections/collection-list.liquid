<section class="section">
  <div class="page-width">
    <div class="section-heading">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="collection-list">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        {%- if col != blank -%}
          <a class="collection-card" href="{{ col.url }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy">
            {%- elsif col.image != blank -%}
              <img src="{{ col.image | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy">
            {%- elsif col.products.first.featured_media -%}
              <img src="{{ col.products.first.featured_media | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy">
            {%- endif -%}
            <div class="collection-card__overlay">
              <h3 class="collection-card__title">{{ col.title }}</h3>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the shop" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Override image" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Collection list",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}