<section class="newsletter">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading | default: 'general.newsletter.heading' | t }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p style="color:var(--color-muted);max-width:520px;margin:0 auto;">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr-only" for="NewsletterEmail">Email</label>
      <input type="email" id="NewsletterEmail" name="contact[email]" required placeholder="{{ 'general.newsletter.placeholder' | t }}">
      <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
      {%- if form.posted_successfully? -%}
        <p style="margin-top:1rem;color:var(--color-accent);">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Temple" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Receive rites, offerings, and new arrivals." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}