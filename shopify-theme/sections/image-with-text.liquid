<section class="section">
  <div class="page-width">
    <div class="image-with-text {% if section.settings.reverse %}image-with-text--reverse{% endif %}">
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}"
               alt="{{ section.settings.image.alt | escape }}"
               width="{{ section.settings.image.width }}"
               height="{{ section.settings.image.height }}"
               loading="lazy">
        {%- endif -%}
      </div>
      <div class="image-with-text__content">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--outline" style="margin-top:1.5rem;">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made with intention" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every offering leaves the Temple prepared as if for a friend.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout", "default": false }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}