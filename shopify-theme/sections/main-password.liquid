<div class="password-page">
  <div class="password-page__inner">
    {%- if section.settings.logo != blank -%}
      <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" style="margin:0 auto 2rem;max-height:80px;">
    {%- endif -%}
    <span class="eyebrow">Opening soon</span>
    <h1>{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <div style="color:var(--color-muted);margin:1rem 0 2rem;">{{ shop.password_message }}</div>
    {%- endif -%}
    {%- form 'storefront_password' -%}
      <div style="display:flex;gap:.5rem;max-width:400px;margin:0 auto;">
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit" class="btn">Enter</button>
      </div>
      {%- if form.errors -%}
        <p style="color:var(--color-accent);margin-top:1rem;">{{ form.errors.messages.form }}</p>
      {%- endif -%}
    {%- endform -%}
    <div style="margin-top:3rem;">
      {%- form 'customer', class: 'newsletter' -%}
        <input type="hidden" name="contact[tags]" value="prospect,newsletter">
        <div style="display:flex;gap:.5rem;max-width:400px;margin:0 auto;">
          <input type="email" name="contact[email]" required placeholder="{{ 'general.newsletter.placeholder' | t }}">
          <button type="submit" class="btn btn--outline">{{ 'general.newsletter.submit' | t }}</button>
        </div>
        {%- if form.posted_successfully? -%}<p style="margin-top:1rem;color:var(--color-accent);">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" }
  ]
}
{% endschema %}