<section class="section">
  <div class="page-width" style="max-width:480px;">
    <div class="section-heading" style="margin-bottom:2rem;"><h1>Reset your password</h1></div>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div style="color:var(--color-accent);margin-bottom:1rem;">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div style="display:grid;gap:1rem;">
        <div><label for="ResetPass">New password</label><input type="password" id="ResetPass" name="customer[password]" required></div>
        <div><label for="ResetPassConfirm">Confirm password</label><input type="password" id="ResetPassConfirm" name="customer[password_confirmation]" required></div>
        <button type="submit" class="btn btn--full">Reset password</button>
      </div>
    {%- endform -%}
  </div>
</section>