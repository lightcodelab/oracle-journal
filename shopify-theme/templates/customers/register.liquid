<section class="section">
  <div class="page-width" style="max-width:480px;">
    <div class="section-heading" style="margin-bottom:2rem;">
      <h1>{{ 'customer.register.title' | t }}</h1>
    </div>
    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div style="color:var(--color-accent);margin-bottom:1rem;">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div style="display:grid;gap:1rem;">
        <div><label for="RegFirst">{{ 'customer.register.first_name' | t }}</label><input type="text" id="RegFirst" name="customer[first_name]"></div>
        <div><label for="RegLast">{{ 'customer.register.last_name' | t }}</label><input type="text" id="RegLast" name="customer[last_name]"></div>
        <div><label for="RegEmail">{{ 'customer.register.email' | t }}</label><input type="email" id="RegEmail" name="customer[email]" required></div>
        <div><label for="RegPass">{{ 'customer.register.password' | t }}</label><input type="password" id="RegPass" name="customer[password]" required></div>
        <button type="submit" class="btn btn--full">{{ 'customer.register.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>