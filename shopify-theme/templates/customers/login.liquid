<section class="section">
  <div class="page-width" style="max-width:480px;">
    <div class="section-heading" style="margin-bottom:2rem;">
      <h1>{{ 'customer.login.title' | t }}</h1>
    </div>
    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div style="color:var(--color-accent);margin-bottom:1rem;">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div style="display:grid;gap:1rem;">
        <div>
          <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
        </div>
        <div>
          <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
          <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn--full">{{ 'customer.login.submit' | t }}</button>
        <div style="text-align:center;font-size:.85rem;">
          <a href="#recover" onclick="document.getElementById('RecoverForm').hidden=false;this.parentElement.hidden=true;return false;">{{ 'customer.login.forgot_password' | t }}</a>
          <span style="color:var(--color-muted);"> · </span>
          <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
        </div>
      </div>
    {%- endform -%}

    <div id="RecoverForm" hidden style="margin-top:2rem;">
      <h2 style="font-size:1.25rem;">{{ 'customer.recover_password.title' | t }}</h2>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p style="color:var(--color-accent);">{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}
        <div style="display:grid;gap:1rem;">
          <div>
            <label for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
            <input type="email" id="RecoverEmail" name="email" required>
          </div>
          <button type="submit" class="btn">{{ 'customer.recover_password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>