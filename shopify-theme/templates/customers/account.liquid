<section class="section">
  <div class="page-width">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;margin-bottom:2rem;">
      <h1>{{ 'customer.account.title' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" style="font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;">{{ 'customer.account.logout' | t }}</a>
    </div>
    <div style="display:grid;grid-template-columns:1fr 2fr;gap:3rem;">
      <aside>
        <h3 style="font-size:1rem;letter-spacing:.14em;text-transform:uppercase;color:var(--color-muted);">{{ 'customer.account.details' | t }}</h3>
        <p>{{ customer.name }}<br>{{ customer.email }}</p>
        <a href="{{ routes.account_addresses_url }}" class="btn btn--outline">Manage addresses</a>
      </aside>
      <div>
        <h3 style="font-size:1rem;letter-spacing:.14em;text-transform:uppercase;color:var(--color-muted);">{{ 'customer.account.orders' | t }}</h3>
        {%- if customer.orders.size > 0 -%}
          <table class="cart-items">
            <thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%b %-d, %Y' }}</td>
                  <td>{{ order.total_price | money }}</td>
                  <td>{{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p style="color:var(--color-muted);">{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>